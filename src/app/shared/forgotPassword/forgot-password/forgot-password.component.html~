<div class="container-fluid vh-100 d-flex align-items-center justify-content-center">
  <div class="row shadow-lg rounded overflow-hidden" style="max-width: 1000px; width: 90%;">
    <div class="col-md-6 p-0">
      <div class="position-relative h-100">
        <img
          src="assets/images/forgot_password.png"
          alt="Recuperar Contraseña"
          class="w-100 h-100"
          style="object-fit: cover;"
        />
      </div>
    </div>

    <div class="col-md-6 p-5 bg-white d-flex flex-column justify-content-center">
      <h2 class="text-center mb-3 text-dark">
        <i class="bi bi-unlock-fill me-2"></i>Recuperar Contraseña
      </h2>
      <p class="text-muted text-center">
        Ingrese su correo electrónico y le enviaremos instrucciones para restablecer su contraseña.
      </p>

      <form [formGroup]="fgPassword" (ngSubmit)="submitRequest()">
        <div class="mb-3">
          <label for="email" class="form-label fw-bold">Correo Electrónico</label>
          <input
            type="email"
            id="email"
            class="form-control"
            formControlName="email"
            placeholder="Ingrese su correo electrónico"
          />
          <div *ngIf="fgPassword.get('email')?.invalid && fgPassword.get('email')?.touched">
            <small class="text-danger" *ngIf="fgPassword.get('email')?.hasError('required')">
              Este campo es obligatorio.
            </small>
            <small class="text-danger" *ngIf="fgPassword.get('email')?.hasError('email')">
              Ingrese un correo válido.
            </small>
          </div>
        </div>
        <div class="d-grid">
          <button type="submit" class="btn btn-warning text-white fw-semibold" [disabled]="fgPassword.invalid">
            <i class="bi bi-envelope-paper me-1"></i>Enviar instrucciones
          </button>
        </div>
        <div *ngIf="successMessage" class="alert alert-success mt-3">
          {{ successMessage }}
        </div>
        <div *ngIf="errorMessage" class="alert alert-danger mt-3">
          {{ errorMessage }}
        </div>
      </form>
      <div class="text-center mt-3">
        <button class="btn btn-outline-secondary btn-sm" (click)="redirectToLogin()">
          <i class="bi bi-arrow-left-circle me-1"></i>Volver al inicio de sesión
        </button>
      </div>
    </div>
  </div>
</div>
